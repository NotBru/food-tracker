#!/bin/sh
# The push hook (install: cp deploy/hooks/reference-transaction .git/hooks/). Runs on the machine you push from.
# Deploy track-shit after each successful push to master.
#
# Git has no post-push hook, and pre-push runs before GitHub has the new
# commits, so the server would pull the old version. This hook runs on every
# ref update instead, and acts when a push moves origin/master: git only does
# that after GitHub has accepted the push.

HOST=notbru   # whatever you type after "ssh" to reach the VPS

[ "$1" = committed ] || exit 0

while read -r old new ref; do
	[ "$ref" = refs/remotes/origin/master ] || continue
	# fetch and pull move origin/master too
	[ "$(git reflog show -1 --format=%gs "$ref" 2>/dev/null)" = "update by push" ] || continue

	# The Android app's F-Droid repo (android/scripts/publish.sh makes it; outside git): up first, so the deploy
	# serves it. Not there yet = nothing to upload.
	repo="$(git rev-parse --show-toplevel)/android/fdroid/repo/"
	if [ -d "$repo" ]; then
		echo "Uploading the F-Droid repo"
		rsync -a --delete --mkpath "$repo" "$HOST":/srv/track-shit/fdroid/repo/ </dev/null ||
			echo "F-Droid repo upload failed (rsync on both ends?)." >&2
	fi

	echo "Deploying $(git log -1 --format='%h %s' "$new") to track-shit.notbru.xyz"
	# -n: don't let ssh read this hook's input
	ssh -n "$HOST" /srv/track-shit/deploy.sh ||
		echo "Deploy failed. The push itself went through." >&2
done
