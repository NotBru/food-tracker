<?xml version="1.0" encoding="utf-8"?>
<!-- Back up the database (Android Auto Backup / device transfer); the data lives only on the device otherwise. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
